# Nome do projeto: vira prefixo dos containers, volumes e rede do docker compose
COMPOSE_PROJECT_NAME=meu-projeto

# API
API_TITLE=Meu Projeto API
API_VERSION=0.1.0
# Prefixo quando a API roda atrás de proxy (ex.: /api/meu-projeto). Vazio em dev.
BASEPATH=
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=*
APP_PORT=8000

# Banco de dados
# POSTGRES_HOST=localhost serve para rodar a API fora do Docker; no compose ele vira "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# pgAdmin
PGADMIN_PORT=4040
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Autenticação
# Chave que assina os tokens (mínimo de 32 caracteres). Em produção use um valor próprio e secreto:
# gere com `openssl rand -hex 32`. O valor abaixo serve só para desenvolvimento.
JWT_SECRET=troque-esta-chave-em-producao-0123456789
# Duração do token de acesso, em minutos
JWT_EXPIRE_MINUTES=60
# Falhas de login seguidas até bloquear a conta, e duração do bloqueio em minutos
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
