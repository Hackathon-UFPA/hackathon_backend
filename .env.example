# Nome do projeto: vira prefixo dos containers, volumes e rede do docker compose
COMPOSE_PROJECT_NAME=meu-projeto

# API
API_TITLE=Meu Projeto API
API_VERSION=0.1.0
# Prefixo quando a API roda atrás de proxy (ex.: /api/meu-projeto). Vazio em dev.
BASEPATH=
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=*
APP_PORT=8000

# Banco de dados
# POSTGRES_HOST=localhost serve para rodar a API fora do Docker; no compose ele vira "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Os testes rodam em outro banco, <POSTGRES_DB>_test, que o docker compose cria e migra sozinho
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# pgAdmin
PGADMIN_PORT=4040
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Autenticação
# Chave que assina os tokens (mínimo de 32 caracteres). Em produção use um valor próprio e secreto:
# gere com `openssl rand -hex 32`. O valor abaixo serve só para desenvolvimento.
JWT_SECRET=troque-esta-chave-em-producao-0123456789
# Duração do token de acesso, em minutos
JWT_EXPIRE_MINUTES=60
# Falhas de login seguidas até bloquear a conta, e duração do bloqueio em minutos
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# E-mail transacional (convites, protocolos, resultado, acessos)
# console: só registra no log, nada é enviado (desenvolvimento). smtp: envia de verdade.
EMAIL_PROVIDER=console
EMAIL_REMETENTE_NOME=Hackathon UFPA
EMAIL_REMETENTE_ENDERECO=nao-responder@hackathon.local
# Só para EMAIL_PROVIDER=smtp. Usuário e senha ficam apenas no ambiente, nunca no código.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
# starttls (porta 587), ssl (porta 465) ou nenhuma (só servidor local de testes)
SMTP_SEGURANCA=starttls
SMTP_TIMEOUT_SEGUNDOS=30
# Endereço do front, usado nos links dos e-mails
FRONTEND_URL=http://localhost:4200
# Fila de envio: intervalo do worker, tamanho do lote e tentativas por e-mail
EMAIL_WORKER_ATIVO=true
EMAIL_INTERVALO_SEGUNDOS=15
EMAIL_LOTE=20
EMAIL_MAX_TENTATIVAS=5
# Espera entre tentativas: base * 2^(tentativa-1), até o máximo (em segundos)
EMAIL_BACKOFF_BASE_SEGUNDOS=30
EMAIL_BACKOFF_MAX_SEGUNDOS=1800
EMAIL_RESERVA_SEGUNDOS=300
